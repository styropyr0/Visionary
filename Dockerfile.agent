# Visionary host agent: watches the machine it runs on and reports it to a
# Visionary server (see "Host agent" in Readme.md).
#   docker build -f Dockerfile.agent -t visionary-agent .
#
# The container must see the host, not itself:
#   docker run -d --name visionary-agent --restart unless-stopped \
#     --pid=host --net=host -v /:/host:ro \
#     -e HOST_ROOT=/host -e HOST_PROC=/host/proc -e HOST_SYS=/host/sys -e HOST_ETC=/host/etc \
#     -e VISIONARY_URL=https://visionary.example.com -e VISIONARY_KEY=<server key> \
#     visionary-agent
#
# --pid=host shows the host's processes, --net=host its interfaces and
# listening ports, and /:/host its filesystems, /etc and logs. gopsutil reads
# HOST_PROC, HOST_SYS and HOST_ETC; the agent reads HOST_ROOT for mounts and
# auth logs, and runs systemctl, journalctl and the package manager of the
# host through chroot into it, so the image needs a shell's chroot and root.

FROM --platform=$BUILDPLATFORM golang:1.26.2-alpine3.22 AS build
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
COPY sdks/go/go.mod sdks/go/go.sum sdks/go/
RUN go mod download
COPY cmd/visionary-agent/ cmd/visionary-agent/
COPY internal/ internal/
COPY sdks/go/ sdks/go/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w -X main.version=$VERSION" -o /out/visionary-agent ./cmd/visionary-agent

# Alpine for busybox chroot; the agent itself is static.
FROM alpine:3.20
COPY --from=build /out/visionary-agent /usr/local/bin/visionary-agent
ENTRYPOINT ["/usr/local/bin/visionary-agent"]
