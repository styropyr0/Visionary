# ---------------------------------------------------------------------------
# Visionary server. Copy to .env for local runs; set real env vars in deploys.
#
# These are the only variables the server reads. Everything else (sign-in,
# the AI analyst, email, ingest keys, limits, thresholds, retention, the
# status page and the security detectors) is set in the dashboard under
# Settings and kept in the database. On a fresh database the dashboard opens
# as an admin until sign-in is saved in Settings -> Sign-in.
#
# Comment lines start with #. A line starting with ; stops the whole file
# from loading.
# ---------------------------------------------------------------------------

# Where the server listens.
VISIONARY_ADDR=:8090

# The database your services' SDKs write to and the dashboard reads. One of:
#   postgres://user:pass@host:5432/db?sslmode=require
#   mysql://user:pass@host:3306/db
#   sqlite:///var/lib/visionary/analytics.db   (Windows: sqlite:///C:/data/analytics.db)
VISIONARY_DATABASE_URL=

# ...or Cloudflare D1: leave the URL empty and fill these in. The token needs
# D1 edit access.
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=
# D1_API_BASE=https://api.cloudflare.com/client/v4

# Locked out? false turns sign-in off: anyone who reaches the server is an
# admin. Fix sign-in in Settings, then remove this and restart.
# VISIONARY_ENABLE_AUTH=false
