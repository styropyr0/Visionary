# ---------------------------------------------------------------------------
# Visionary server. Copy to .env for local runs; set real env vars in deploys.
# ---------------------------------------------------------------------------

VISIONARY_ADDR=:8090

# The database the SDKs write to and the dashboards read. One of:
#   postgres://user:pass@host:5432/db?sslmode=require
#   mysql://user:pass@host:3306/db
#   sqlite:///var/lib/visionary/analytics.db
VISIONARY_DATABASE_URL=
# ...or Cloudflare D1: leave the URL empty and fill these in.
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# 32+ characters. Without it, everyone is signed out on each restart.
VISIONARY_SESSION_SECRET=
VISIONARY_SESSION_TTL=12h
# Behind a reverse proxy, so cookies are Secure and rate limits see real IPs.
VISIONARY_TRUST_PROXY=false

# The AI analyst (optional). Without a key, dashboards still work.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
VISIONARY_MODEL=gpt-4.1
# Your product's name, and facts about your data the analyst should know.
VISIONARY_APP_NAME=
VISIONARY_DATA_NOTES=

# Apdex and SLO thresholds, retention, the status page and CPU profiling are
# set in the dashboard (Settings), not here.

# Email for alerts and digests (optional).
# VISIONARY_SMTP_HOST=smtp.example.com
# VISIONARY_SMTP_PORT=587
# VISIONARY_SMTP_USER=
# VISIONARY_SMTP_PASSWORD=
# VISIONARY_SMTP_FROM=visionary@example.com
# VISIONARY_DIGEST_TZ=Asia/Kolkata

# Ingest keys: OpenTelemetry (server) and browser/mobile (client). Keys made in
# Settings work too. Browsers are also checked against these origins.
# VISIONARY_INGEST_KEYS=
# VISIONARY_CLIENT_KEYS=
# VISIONARY_CLIENT_ORIGINS=https://app.example.com

# Security detectors over api_logs (on by default; README "Security monitoring").
# VISIONARY_SECURITY=true
# Your login routes as path globs; default: routes containing login, auth, token...
# VISIONARY_SECURITY_LOGIN_ROUTES=/auth/*,/api/v1/sessions
# Never flag these IPs or CIDRs (health checks, office, internal callers).
# VISIONARY_SECURITY_IGNORE_IPS=10.0.0.0/8
# Thresholds per 5-minute window: failed logins per IP, accounts per IP,
# IPs per account, probe paths per IP, requests/min floor, 403s per user.
# VISIONARY_SECURITY_BRUTEFORCE=10
# VISIONARY_SECURITY_STUFFING_ACCOUNTS=5
# VISIONARY_SECURITY_TARGETED_IPS=5
# VISIONARY_SECURITY_SCANNER_HITS=3
# VISIONARY_SECURITY_RATE_MIN=120
# VISIONARY_SECURITY_FORBIDDEN=20

# ---------------------------------------------------------------------------
# Sign-in. Pick one mode. The README has a commented preset for each.
# ---------------------------------------------------------------------------

# shared: one team password, nothing else needed.
VISIONARY_AUTH_MODE=shared
VISIONARY_SHARED_PASSWORD=
# Optional read-only shared login:
# VISIONARY_VIEWER_PASSWORD=

# password: sign in through your API's existing login, in one step.
# VISIONARY_AUTH_MODE=password
# VISIONARY_AUTH_PROVIDER=Acme
# VISIONARY_AUTH_BASE_URL=https://api.example.com
# VISIONARY_AUTH_IDENTIFIER_LABEL=Email
# VISIONARY_AUTH_IDENTIFIER_INPUT=email
# VISIONARY_AUTH_IDENTIFIER_NORMALIZE=lowercase
# VISIONARY_AUTH_LOGIN=POST /auth/login
# VISIONARY_AUTH_LOGIN_BODY={"email":"{{identifier}}","password":"{{password}}"}
# VISIONARY_AUTH_PROFILE=GET /me
# VISIONARY_AUTH_LOGOUT=POST /auth/logout
# VISIONARY_AUTH_FIELD_TOKEN=token
# VISIONARY_AUTH_FIELD_ROLE=role
# VISIONARY_AUTH_FIELD_NAME=name
# VISIONARY_AUTH_FIELD_HANDLE=email
# Who may sign in; * lets every user of the API in.
# VISIONARY_ALLOWED_ROLES=admin

# otp: sign in through your API's one-time-code flow (phone or email), in two steps.
# VISIONARY_AUTH_MODE=otp
# VISIONARY_AUTH_BASE_URL=https://api.example.com
# VISIONARY_AUTH_IDENTIFIER_LABEL=Phone number
# VISIONARY_AUTH_IDENTIFIER_INPUT=tel
# VISIONARY_AUTH_IDENTIFIER_NORMALIZE=digits
# VISIONARY_AUTH_IDENTIFIER_PATTERN=^[0-9]{8,15}$
# VISIONARY_AUTH_CODE_LENGTH=6
# VISIONARY_AUTH_START=POST /auth/otp/request
# VISIONARY_AUTH_START_BODY={"phone":"{{identifier}}"}
# VISIONARY_AUTH_VERIFY=POST /auth/otp/verify
# VISIONARY_AUTH_VERIFY_BODY={"phone":"{{identifier}}","code":"{{code}}"}
# VISIONARY_AUTH_PROFILE=GET /me
# VISIONARY_AUTH_FIELD_TOKEN=data.token
# VISIONARY_AUTH_FIELD_ROLE=data.role
# VISIONARY_ALLOWED_ROLES=ADMIN
# ...or map roles to viewer/editor/admin:
# VISIONARY_ROLE_MAP=ADMIN=admin,ENGINEER=editor,SUPPORT=viewer
# ...and everyone else as a viewer: ADMIN=admin,*=viewer
# If the API wants the user's location at sign-in, the browser asks for it:
# VISIONARY_AUTH_LOCATION=required   (none | optional | required)
# ...and the body uses "latitude":"{{latitude}}","longitude":"{{longitude}}".

# none: no sign-in at all. Local use only; never expose it.
# VISIONARY_AUTH_MODE=none
