# ---------------------------------------------------------------------------
# Visionary server. Copy to .env for local runs; set real env vars in deploys.
#
# Only where to listen and which database to use live here. Sign-in, the AI
# analyst, email, ingest keys, limits and the security detectors are set in
# the dashboard (Settings) and kept in the database. On a fresh database the
# dashboard opens as an admin until sign-in is saved in Settings -> Sign-in.
# ---------------------------------------------------------------------------

VISIONARY_ADDR=:8090

# The database the SDKs write to and the dashboards read. One of:
#   postgres://user:pass@host:5432/db?sslmode=require
#   mysql://user:pass@host:3306/db
#   sqlite:///var/lib/visionary/analytics.db
VISIONARY_DATABASE_URL=
# ...or Cloudflare D1: leave the URL empty and fill these in.
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# Locked out? false turns sign-in off: anyone who reaches the server is an
# admin. Fix sign-in in Settings, then remove this and restart.
# VISIONARY_ENABLE_AUTH=false
