<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Styropyr0.Visionary</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Visionary.AspNetCore</PackageId>
    <!-- Dev version. CI packs with -p:Version=<tag without v>; SdkVersion (sdk_version) is read
         from AssemblyInformationalVersion, which follows Version. -->
    <Version>0.1.0</Version>
    <Authors>styropyr0</Authors>
    <Company>styropyr0</Company>
    <Copyright>Copyright styropyr0</Copyright>
    <Description>Request logs, system metrics, spans and errors from ASP.NET Core into the Visionary tables (Cloudflare D1, PostgreSQL, MySQL or SQLite).</Description>
    <PackageTags>visionary;aspnetcore;analytics;apm;monitoring;logging;metrics</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/styropyr0/Visionary/tree/main/sdks/dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/styropyr0/Visionary.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The optional CPU profiler package (its own package so this one stays free of
         TraceEvent) and the tests use the agent, store and writer directly. -->
    <InternalsVisibleTo Include="Visionary.AspNetCore.Profiling" />
    <InternalsVisibleTo Include="Visionary.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copies of sdks/go/schema, byte for byte; see SPEC.md "Tables". -->
    <EmbeddedResource Include="Schema\**\*.sql" LogicalName="Visionary.Schema.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
