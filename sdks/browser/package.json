{
  "name": "visionary-browser",
  "version": "0.1.0",
  "description": "Real user monitoring for Visionary: Web Vitals, page loads, route changes, API calls and errors from the browser.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/visionary.min.js",
  "jsdelivr": "./dist/visionary.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./iife": "./dist/visionary.min.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "rum",
    "web-vitals",
    "monitoring",
    "analytics",
    "visionary"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/styropyr0/visionary",
    "directory": "sdks/browser"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.6.3"
  }
}
