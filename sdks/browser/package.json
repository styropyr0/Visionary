{
  "name": "visionary-browser",
  "version": "0.1.0",
  "description": "Real user monitoring for Visionary: Web Vitals, page loads, route changes, API calls and errors from the browser.",
  "license": "Apache-2.0",
  "author": "styropyr0",
  "homepage": "https://github.com/styropyr0/Visionary/tree/main/sdks/browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/styropyr0/Visionary.git",
    "directory": "sdks/browser"
  },
  "bugs": {
    "url": "https://github.com/styropyr0/Visionary/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/visionary.min.js",
  "jsdelivr": "./dist/visionary.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./iife": "./dist/visionary.min.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "rum",
    "web-vitals",
    "monitoring",
    "analytics",
    "visionary"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
