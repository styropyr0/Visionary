{
  "name": "visionary-sdk",
  "version": "0.1.0",
  "description": "Visionary collector for Node.js: logs API requests, samples system metrics and records spans and errors into your database.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "styropyr0",
  "homepage": "https://github.com/styropyr0/Visionary/tree/main/sdks/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/styropyr0/Visionary.git",
    "directory": "sdks/node"
  },
  "bugs": {
    "url": "https://github.com/styropyr0/Visionary/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsup --config tsup.test.config.ts --silent && node --test test-dist/*.test.js",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "visionary",
    "analytics",
    "apm",
    "monitoring",
    "metrics",
    "express",
    "fastify",
    "koa",
    "nestjs"
  ],
  "peerDependencies": {
    "better-sqlite3": ">=9",
    "mysql2": ">=3",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsup": "8.3.5",
    "typescript": "5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
