{
  "provider": "Acme",
  "type": "password",
  "base_url": "https://api.example.com",
  "identifier": {
    "label": "Email",
    "placeholder": "you@company.com",
    "input": "email",
    "normalize": "lowercase"
  },
  "verify": { "method": "POST", "path": "/auth/login", "body": { "email": "{{identifier}}", "password": "{{password}}" } },
  "profile": { "method": "GET", "path": "/me" },
  "logout": { "method": "POST", "path": "/auth/logout" },
  "token": { "header": "Authorization", "prefix": "Bearer " },
  "fields": {
    "token": "token",
    "expires_at": "expires_at",
    "user_id": "id",
    "name": "name",
    "handle": "email",
    "role": "roles",
    "error_message": "message"
  },
  "allowed_roles": ["admin", "analyst"]
}
